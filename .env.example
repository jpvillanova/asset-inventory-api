# Copie para .env e ajuste conforme necessário.

# String de conexão (SQLite por padrão; use PostgreSQL em produção).
# Ex.: postgresql://usuario:senha@localhost:5432/inventario
DATABASE_URL=sqlite:///./inventory.db

# Chave para assinar os tokens JWT (gere uma aleatória em produção).
SECRET_KEY=troque-esta-chave

# Tempo de expiração do token (minutos).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Credenciais do admin criado no primeiro boot.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
